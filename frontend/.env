VITE_API_URL=https://aerio-backend.onrender.com

# Optional TURN relay for voice/video calls — needed for reliable
# peer-to-peer connectivity across restrictive/mobile-carrier NATs (STUN
# alone often isn't enough for two phones on two different networks).
# Leave unset to keep using STUN-only. Get these from a TURN provider
# (e.g. Twilio Network Traversal, Cloudflare Calls, Xirsys) or a
# self-hosted coturn instance — do NOT commit real credentials here.
# VITE_TURN_URL=turn:your-turn-host:3478
# VITE_TURN_USERNAME=your-turn-username
# VITE_TURN_CREDENTIAL=your-turn-credential

VITE_TURN_URL=turn:global.relay.metered.ca:80,turn:global.relay.metered.ca:80?transport=tcp,turn:global.relay.metered.ca:443,turns:global.relay.metered.ca:443?transport=tcp
VITE_TURN_USERNAME=e2ddd7510acad91ff2a82dd2
VITE_TURN_CREDENTIAL=ByAFWEPsxv8F6Xk7